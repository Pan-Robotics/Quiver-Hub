# =============================================================================
# Quiver Hub - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# MySQL/MariaDB connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://quiver:password@localhost:3306/quiver_hub

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------
# Secret key for JWT token signing - MUST be changed in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-change-in-production

# -----------------------------------------------------------------------------
# Admin User (Optional - for initial setup)
# -----------------------------------------------------------------------------
# If set, creates an admin user on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Allow new user registration (true/false)
ALLOW_REGISTRATION=true

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Application display name
APP_NAME=Quiver Hub

# Server port (default: 3000)
PORT=3000

# Node environment (development/production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Settings (Vite)
# -----------------------------------------------------------------------------
# These are exposed to the frontend via import.meta.env

# Application title shown in UI
VITE_APP_TITLE=Quiver Hub

# Application logo URL (optional)
# VITE_APP_LOGO=https://your-domain.com/logo.png

# Allow registration from frontend
VITE_ALLOW_REGISTRATION=true
